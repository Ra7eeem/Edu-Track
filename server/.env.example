# ── Required on Vercel Dashboard ──────────────────────────────────
# Project → Settings → Environment Variables

NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/edusync?retryWrites=true&w=majority

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-production-secret-must-be-at-least-32-characters
JWT_EXPIRES_IN=7d

# File Upload — /tmp is the only writable dir on Vercel
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
USER_RATE_LIMIT_MAX=800
AUTH_RATE_LIMIT_MAX=20

# Upstash Redis — shared rate-limit store across Vercel serverless instances.
# Without this every instance has its own counter (unreliable on serverless).
# Get from: https://console.upstash.com → Create Redis DB → REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# CORS — your deployed Next.js frontend URL
CORS_ORIGIN=https://your-app.vercel.app

# Logging
LOG_LEVEL=error
